program pointer_lista;

uses crt;

type
    TInfo = string;
    
    // Estrutura do Dicionario (Lista Simples com PT e EN no mesmo no)
    PDicionario = ^TDicionario;
    TDicionario = record
        verbetePT: TInfo;
        verbeteEN: TInfo;
        prox: PDicionario;
    end;

    // Estrutura da Lista Principal (Lista Dupla para as Palavras-Chave)
    TNode = ^TElemento;
    TElemento = record
        ant: Tnode;
        chave: TInfo;
        dicionario: PDicionario; 
        prox: TNode;
    end;

var
    opcao: byte;
    strChave, str, strIngles: TInfo;
    str_lista: TNode;

// --- FUNCAO NOVA: Evita problemas com a tabela ASCII ---
function Maiuscula(s: string): string;
var i: integer;
begin
    for i := 1 to Length(s) do
        s[i] := UpCase(s[i]);
    Maiuscula := s;
end;
// --------------------------------------------------------

function BuscarNo(lista: TNode; valor: TInfo): TNode;
var atual: TNode;
    encontrado: boolean;
begin
    atual := lista;
    encontrado := false;

    while (atual <> nil) and (not encontrado) do
    begin
        // Compara ignorando maiusculas/minusculas
        if Maiuscula(atual^.chave) = Maiuscula(valor) then
            encontrado := true
        else
            atual := atual^.prox;
    end;

    if encontrado then
        BuscarNo := atual
    else
        BuscarNo := nil;
end;

procedure CriarListaDupla(var lista : TNode);
begin
    lista := nil;
end;

procedure AdicionarDupla(var lista : TNode; chave : TInfo);
var aux, anterior, atual : TNode;
begin
    new(aux);

    if aux = nil then
    begin
        write('Memoria cheia!'); readkey;
    end
    else
    begin
        aux^.ant := nil;
        aux^.chave := chave;
        aux^.dicionario := nil;
        aux^.prox := nil;
        
        // Compara ignorando maiusculas/minusculas
        if (lista = nil) or (Maiuscula(chave) < Maiuscula(lista^.chave)) then
        begin
            aux^.prox := lista;

            if lista <> nil then
                lista^.ant := aux;
            
            lista := aux;
        end
        else
        begin
            anterior := lista;
            atual := lista^.prox;
            
            // Compara ignorando maiusculas/minusculas
            while (atual <> nil) and (Maiuscula(chave) > Maiuscula(atual^.chave)) do
            begin
                anterior := atual;
                atual := atual^.prox;
            end;
            
            aux^.prox := atual;
            aux^.ant := anterior;
            anterior^.prox := aux;
            if atual <> nil then
                atual^.ant := aux;
        end;
    end;
end;

procedure RemoverDupla(var lista : TNode; chave : TInfo);
var noCerto : TNode;
begin
    if lista = nil then
    begin
        write('Lista vazia!'); readkey;
    end
    else
    begin
        noCerto := BuscarNo(lista, chave);
        
        if noCerto = nil then
        begin
            write('Elemento nao encontrado!');
            readkey;
        end
        else
        begin
            if noCerto^.ant = nil then
                lista := noCerto^.prox
            else
                noCerto^.ant^.prox := noCerto^.prox;
                
            if noCerto^.prox <> nil then
                noCerto^.prox^.ant := noCerto^.ant;
            
            writeln('Elemento ', noCerto^.chave, ' removido!');
            dispose(noCerto);
            readkey;
        end;
    end;
end;

procedure InserirChave(var lista: TNode; chave:TInfo);
begin
    if BuscarNo(lista, chave) <> nil then
    begin
        writeln('Chave "', chave, '" ja existe!');
        readkey;
    end
    else
        AdicionarDupla(lista, chave);
end;

procedure InserirVerbete(var lista: TNode; chaveBusca, verbetePT, verbeteEN: TInfo);
var 
    noCerto: TNode;
    novoVerbete, anterior, atual: PDicionario;
begin
    noCerto := BuscarNo(lista, chaveBusca);

    if noCerto = nil then
    begin
        writeln('Palavra-chave "', chaveBusca, '" nao encontrada! Cadastre a chave primeiro.');
        readkey;
    end
    else
    begin
        atual := noCerto^.dicionario;
        // Busca ignorando maiusculas/minusculas
        while (atual <> nil) and (Maiuscula(atual^.verbetePT) <> Maiuscula(verbetePT)) do
            atual := atual^.prox;

        if atual <> nil then
        begin
            writeln('"', verbetePT, '" ja existe no grupo de "', noCerto^.chave, '"!');
            readkey;
        end
        else
        begin
            new(novoVerbete);
            novoVerbete^.verbetePT := verbetePT;
            novoVerbete^.verbeteEN := verbeteEN;
            novoVerbete^.prox := nil;

            // Insere em ordem ignorando maiusculas/minusculas
            if (noCerto^.dicionario = nil) or (Maiuscula(verbetePT) < Maiuscula(noCerto^.dicionario^.verbetePT)) then
            begin
                novoVerbete^.prox := noCerto^.dicionario;
                noCerto^.dicionario := novoVerbete;
            end
            else
            begin
                anterior := noCerto^.dicionario;
                atual := noCerto^.dicionario^.prox;

                while (atual <> nil) and (Maiuscula(verbetePT) > Maiuscula(atual^.verbetePT)) do
                begin
                    anterior := atual;
                    atual := atual^.prox;
                end;

                novoVerbete^.prox := atual;
                anterior^.prox := novoVerbete; 
            end;

            writeln('"', verbetePT, ' -> ', verbeteEN, '" inserido no grupo de "', noCerto^.chave, '".');
            readkey;
        end;
    end;
end;

procedure RemoverVerbete(var lista: TNode; chaveBusca, verbetePT: TInfo);
var 
    noCerto: TNode;
    anterior, atual: PDicionario;
begin
    noCerto := BuscarNo(lista, chaveBusca);
    
    if noCerto = nil then
    begin
        writeln('Palavra-chave "', chaveBusca, '" nao encontrada!');
        readkey;
    end
    else
    begin
        anterior := nil;
        atual := noCerto^.dicionario;
        
        // Busca para remover ignorando maiusculas/minusculas
        while (atual <> nil) and (Maiuscula(atual^.verbetePT) <> Maiuscula(verbetePT)) do
        begin
            anterior := atual;
            atual := atual^.prox;
        end;
        
        if atual = nil then
        begin
            writeln('"', verbetePT, '" nao encontrado no grupo de "', noCerto^.chave, '"');
            readkey;
        end
        else
        begin
            if anterior = nil then
                noCerto^.dicionario := atual^.prox
            else
                anterior^.prox := atual^.prox;
            
            dispose(atual); 
            
            writeln('"', verbetePT, '" removido do grupo de "', noCerto^.chave, '"');
            readkey;
        end;
    end;
end;

procedure Consultar(lista: Tnode; chaveBusca, verbetePT: TInfo);
var 
    noCerto: TNode;
    atual: PDicionario;
begin
    noCerto := BuscarNo(lista, chaveBusca);
    
    if noCerto = nil then
    begin
        writeln('Palavra-chave "', chaveBusca, '" nao encontrada!');
        readkey;
    end
    else
    begin
        atual := noCerto^.dicionario;
        
        // Busca para consulta ignorando maiusculas/minusculas
        while (atual <> nil) and (Maiuscula(atual^.verbetePT) <> Maiuscula(verbetePT)) do
            atual := atual^.prox;
        
        if atual = nil then
        begin
            writeln('"', verbetePT, '" nao encontrado no grupo de "', noCerto^.chave, '"!');
            readkey;
        end
        else
        begin
            writeln('[PT] ', atual^.verbetePT, ' -> [EN] ', atual^.verbeteEN);
            writeln('(grupo: ', noCerto^.chave, ')');
            readkey;
        end;
    end
end;

procedure EscreveTudo(lista: TNode);
var 
    noAtual: TNode;
    verbete: PDicionario;
begin
    if lista = nil then
    begin
        writeln('Dicionario vazio!');
        readkey;
    end
    else
    begin
        noAtual := lista;
        
        while noAtual <> nil do
        begin
            writeln('[ ', noAtual^.chave, ' ]');
            verbete := noAtual^.dicionario;
            
            if verbete = nil then
                writeln(' (Nenhum verbete neste no)')
            else
            begin
                while verbete <> nil do
                begin
                    writeln('  [PT] ', verbete^.verbetePT, ' ->  [EN] ', verbete^.verbeteEN);
                    verbete := verbete^.prox;
                end;
            end;
            noAtual := noAtual^.prox;
        end;
        readkey;
    end;
end;

begin
    opcao := 1;
    CriarListaDupla(str_lista);

    while opcao <> 0 do
    begin
        clrscr;
        writeln('0 - Sair');
        writeln('1 - Incluir palavra-chave');
        writeln('2 - Incluir no dicionario');
        writeln('3 - Remover do dicionario');
        writeln('4 - Consultar');
        writeln('5 - Escrever todo o dicionario');
        readln(opcao);
        writeln;

        case opcao of
            1: begin
                clrscr;
                write('Digite sua palavra-chave: ');
                readln(str);
                InserirChave(str_lista, str);
            end;

            2: begin
                clrscr;
                write('Insira a palavra-chave (grupo)  : ');
                readln(strChave);
                write('Insira o verbete em portugues : ');
                readln(str);
                write('Insira a traducao em ingles   : ');
                readln(strIngles);
                InserirVerbete(str_lista, strChave, str, strIngles);
            end;
            
            3: begin
                clrscr;
                write('Insira a palavra-chave (grupo) : ');
                readln(strChave);
                write('Digite o verbete a ser removido: ');
                readln(str);
                RemoverVerbete(str_lista, strChave, str);
            end;
            
            4: begin
                clrscr;
                write('Insira a palavra-chave (grupo)   : ');
                readln(strChave);
                write('Insira o verbete a ser consultado: ');
                readln(str);
                Consultar(str_lista, strChave, str);
            end;
            
            5: begin
                clrscr;
                EscreveTudo(str_lista);
            end;
        end;
    end;
end.
